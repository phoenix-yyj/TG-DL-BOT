# Required Telegram application credentials from https://my.telegram.org
API_ID=
API_HASH=

# Required bot token from @BotFather
BOT_TOKEN=

# Required: only this Telegram numeric user ID may use the bot.
OWNER_USER_ID=

# Optional file logging. Leave empty to use container stdout only.
# LOG_FILE=downloads/bot.log

# Display language for command replies. Currently supported: zh_CN (default).
# Telegram users whose language starts with zh are automatically mapped to zh_CN.
BOT_LOCALE=zh_CN

# Optional: required only to access private channels with a user account
SESSION=

# === Rate Limiter Configuration (Optional) ===
# RATE_LIMIT_RATE: Tokens per second (default: 1.0)
# RATE_LIMIT_BURST: Max tokens to hold (default: 5)
# Adjust for your use case:
# - High volume: 2.0 (2 msgs/sec)
# - Normal: 1.0 (1 msg/sec) - DEFAULT
# - Low volume: 0.5 (1 msg every 2 sec)
RATE_LIMIT_RATE=1.0
RATE_LIMIT_BURST=5

# === Concurrency Configuration (Optional) ===
# BOT_WORKERS: Pyrogram client workers (default: 4, was 8)
# MAX_CONCURRENT_DOWNLOADS: Global adaptive download concurrency ceiling (default: 2)
# MIN_CONCURRENT_DOWNLOADS: Lower bound for adaptive concurrency (default: 1)
# DOWNLOAD_ADAPTIVE_COOLDOWN_SEC: Restore configured concurrency after this healthy cooldown (default: 30)
# Reduce these if you hit rate limits:
BOT_WORKERS=4
MAX_CONCURRENT_DOWNLOADS=2
MIN_CONCURRENT_DOWNLOADS=1
DOWNLOAD_ADAPTIVE_COOLDOWN_SEC=30
# DOWNLOAD_TIMEOUT_SEC: Maximum duration of one media download (default: 300)
DOWNLOAD_TIMEOUT_SEC=300

# Optional post-download archive rules (default path is attached_assets/archive_rules.json)
# ARCHIVE_RULES_PATH=attached_assets/archive_rules.json

# Optional automatic archive monitoring (requires SESSION and userbot access).
# AUTO_DOWNLOAD_ENABLED=true
# AUTO_DOWNLOAD_CONFIG_PATH=attached_assets/auto_download.json
